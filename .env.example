# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only write credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters, used only to HMAC rotating rate-limit keys.
RATE_LIMIT_HMAC_SECRET=
# Browser-visible canonical origin used to validate write requests.
APP_ORIGIN=http://localhost:3000
# Required outside Vercel. Your trusted reverse proxy must overwrite this
# header and prevent clients from supplying it directly.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Optional and disabled by default. Values are public browser identifiers.
# NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# NEXT_PUBLIC_SUPPORTKORI_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_SUPPORTKORI_URL=
# NEXT_PUBLIC_DONATION_URL=
# NEXT_PUBLIC_FEATURE_REQUEST_URL=
# NEXT_PUBLIC_PRESS_URL=

# Optional legacy key name supported by the app
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
